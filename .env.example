# SerpAPI key for live Google Lens reverse image searches (free account at https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Blockchain Node URL (Foundry Anvil default: http://127.0.0.1:8545)
ANVIL_RPC_URL=http://127.0.0.1:8545

# Optional: Anvil deployer private key (defaults to Anvil's standard pre-funded account #0)
# ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: Pre-deployed contract address (if omitted, pipeline auto-deploys a fresh contract)
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
